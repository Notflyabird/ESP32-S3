# ESP32-S3-WROOM-1 N16R8: 16 MB QIO flash and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# One wake word followed by Chinese or English MultiNet5 commands.
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_CN_MULTINET5_RECOGNITION_QUANT8=y
CONFIG_SR_MN_EN_MULTINET5_SINGLE_RECOGNITION_QUANT8=y

# The project uses the legacy I2S driver for the INMP441 input path.
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_COREDUMP_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# USB Serial/JTAG: primary console (GPIO19=D-, GPIO20=D+), also supports USB download
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y

# =================  L2: Tickless Idle + L3: DFS 动态降频  =================
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# 默认 CPU 频率 160 MHz：空闲时 DFS 自动降到 40MHz；重负载由 PM Lock 拉到 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# =================  L6-A: Light-Sleep 支持  =================
# 注：esp_light_sleep_start() API 在 CONFIG_PM_ENABLE=y 时即默认可用（ESP-IDF 内置），
#     GPIO RTC 唤醒源 (gpio_wakeup_enable + esp_sleep_enable_ext0_wakeup) 同样默认启用。
#     不再手动设置 ESP_SLEEP_* / PM_* 系列 workaround 项——它们中的一部分在
#     v5.3.5 的 bootloader 精简 Kconfig 中不存在，会导致 bootloader 子工程
#     CMake configure 失败 → ninja subcommand failed。默认值已满足：
#     PSRAM 睡眠默认保持自刷新（AFE/素材安全），RTC 内存默认不掉电（安全）。
#     如需微调，改主工程 sdkconfig（menuconfig），不要写 sdkconfig.defaults。
